pipeline {
    agent any
    environment {
        SONAR_SCANNER_HOME = tool 'SonarQube'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        IMAGE_NAME = 'divyeshsali/amezon-prime'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        
        stage('Git Checkout') {
            steps {
               git branch: 'main', url: 'https://github.com/abhisheksali55/Amazon-Prime-project.git'
               }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                sh '''
                    $SONAR_SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectKey=CICD-DevopsProject \
                    -Dsonar.sources=.
                '''
            }
            }
        }
        stage('Trivy FS Scan') {
            steps {
              sh 'trivy fs --format table -o trivy-fs-report.html --db-repository ghcr.io/aquasecurity/trivy-db:2 .'
            }
        }
        stage('Docker Build Image') {
            steps {
                 sh "docker build -t $IMAGE_NAME:$IMAGE_TAG ."
                 sh "docker tag $IMAGE_NAME:$IMAGE_TAG $IMAGE_NAME:latest"
            }
        }
        stage('Image Trivy Scan') {
            steps {
             sh "trivy image --severity HIGH,CRITICAL --format table -o trivy-image-report.html $IMAGE_NAME:$IMAGE_TAG"
            }
        }
        stage('Docker Hub Login') {
            steps {
             sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
            }
        }
        stage('Docker Hub Push') {
            steps {
                sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                sh "docker push ${IMAGE_NAME}:latest"
            }
        }
        stage('Update Kubernetes Manifest') {
            steps {
                echo 'Hello World'
            }
        }
        
    }

    post {
        success {
            emailext (
                subject: "✅ SUCCESS: '${env.JOB_NAME}' [${env.BUILD_NUMBER}]",
                body: "Build successful! Image: ${IMAGE_NAME}:${IMAGE_TAG}<br>URL: ${env.BUILD_URL}",
                to: 'abhisheksali55@gmail.com',
                mimeType: 'text/html'
            )
        }
        failure {
            emailext (
                subject: "❌ FAILED: '${env.JOB_NAME}' [${env.BUILD_NUMBER}]",
                body: "Build failed. Check logs: ${env.BUILD_URL}console",
                to: 'abhisheksali55@gmail.com',
                mimeType: 'text/html'
            )
        }
        
    }
}
